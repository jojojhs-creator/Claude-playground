//@version=5
// Opening Range (8am) — Bounce, Break & Failed-Break Signals
//
// Locks the HIGH/LOW of the 08:00 hourly candle, extends both levels, and
// signals on how price interacts with them:
//   BOUNCE   — wicks through a level, closes back INSIDE  -> target opposite level
//   BREAK    — closes DECISIVELY outside                  -> target measured move
//   RE-ENTRY — broke out, failed, closed back INSIDE      -> target opposite level
//
// Risk is CAPPED rather than signals being rejected. On a large breakout candle
// the stop is placed at most maxRisk ATR away instead of all the way back at the
// level, so a strong trending move still produces a tradeable order instead of
// being discarded for "chasing". Break targets project from the entry, so the
// reward does not shrink as the entry runs.
//
// Start on the Loose preset. Tighten only if you see too many bad signals.
//
// Works on 1/5/15/30m. Signals evaluate on CLOSED bars — alerts "Once Per Bar Close".

indicator("Opening Range 8am — Bounce, Break & Failed Break", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ── Session ───────────────────────────────────────────────────────────────────
tzIn = input.string("UTC", "Timezone", options=["UTC", "America/New_York", "Europe/London", "Asia/Dubai", "Asia/Tokyo", "Australia/Sydney", "Europe/Berlin"], group="Range")
rangeHour = input.int(8, "Range start hour", minval=0, maxval=23, group="Range")
rangeMinutes = input.int(60, "Range length (minutes)", minval=5, group="Range")
activeHours = input.int(14, "Stop signalling after (hours)", minval=1, maxval=24, group="Range")

// ── Preset: sets every filter at once. Pick Custom to use the manual values ───
preset = input.string("Loose", "Filter preset", options=["Loose", "Balanced", "Strict", "Custom"], group="Preset")

// ── Which signals to take ─────────────────────────────────────────────────────
useBounce = input.bool(true, "Bounce signals", group="Signals")
useBreak = input.bool(true, "Breakout signals", group="Signals")
useReentry = input.bool(true, "Failed-break re-entry signals", group="Signals")

// ── Manual filters (used when preset = Custom) ────────────────────────────────
cUseVol = input.bool(false, "Require above-average volume", group="Custom filters")
volLen = input.int(20, "Volume average length", minval=2, group="Custom filters")
cVolMult = input.float(1.2, "Volume must exceed average x", minval=0.5, step=0.1, group="Custom filters")
cMinBody = input.float(0.0, "Min candle body (% of its range)", minval=0.0, maxval=100.0, step=5.0, group="Custom filters")
cMinRR = input.float(0.8, "Minimum reward:risk", minval=0.1, step=0.1, group="Custom filters")
cMaxRisk = input.float(1.5, "Cap stop distance at (x ATR)", minval=0.3, step=0.1, group="Custom filters")
cCooldown = input.int(1, "Min bars between signals", minval=0, group="Custom filters")
cMinRange = input.float(0.0, "Skip day if range smaller than (x ATR)", minval=0.0, step=0.25, group="Custom filters")
cMaxSignals = input.int(8, "Max signals per day (0 = unlimited)", minval=0, group="Custom filters")

reqDirCandle = input.bool(true, "Signal candle must close in trade direction", group="Custom filters")
minWickAtr = input.float(0.05, "Bounce: min wick beyond level (x ATR)", minval=0.0, step=0.05, group="Custom filters")
minBreakAtr = input.float(0.05, "Break: min close beyond level (x ATR)", minval=0.0, step=0.05, group="Custom filters")
noBounceAfterBreak = input.bool(true, "No plain bounces off a broken level", group="Custom filters")

// ── Targets ───────────────────────────────────────────────────────────────────
slAtrBuf = input.float(0.5, "Stop buffer beyond level (x ATR)", minval=0.0, step=0.1, group="Targets")
breakTpMult = input.float(1.0, "Break TP = range height x", minval=0.1, step=0.1, group="Targets")
trimAtPct = input.float(45.0, "Trim at % of the way to TP", minval=5.0, maxval=95.0, step=5.0, group="Targets")
trimSizePct = input.float(50.0, "Trim this % of the position", minval=10.0, maxval=90.0, step=5.0, group="Targets")
beAfterTrim = input.bool(true, "Move stop to breakeven after trim", group="Targets")

useHtf = input.bool(false, "Only trade with the higher-timeframe trend", group="Trend filter")
htfTf = input.timeframe("240", "Higher timeframe", group="Trend filter")
htfEmaLen = input.int(50, "HTF EMA length", minval=2, group="Trend filter")

showStats = input.bool(true, "Show results table", group="Display")

// ── Display ───────────────────────────────────────────────────────────────────
showLevels = input.bool(true, "Shade the opening-range hour", group="Display")
showPosition = input.bool(true, "Draw position box on each signal", group="Display")
posMinutes = input.int(60, "Position box length (minutes)", minval=5, group="Display")
compactLabels = input.bool(false, "Compact labels (arrow only)", group="Display")
showBlocked = input.bool(true, "Show blocked setups and why", group="Display")

// ── Resolve the preset ────────────────────────────────────────────────────────
isCustom = preset == "Custom"
isLoose = preset == "Loose"
isBal = preset == "Balanced"
isStrict = preset == "Strict"

useVol = isCustom ? cUseVol : isStrict
volMult = isCustom ? cVolMult : 1.2
minBodyPct = isCustom ? cMinBody : isLoose ? 0.0 : isBal ? 20.0 : 35.0
minRR = isCustom ? cMinRR : isLoose ? 0.8 : isBal ? 1.0 : 1.5
maxRiskAtr = isCustom ? cMaxRisk : isLoose ? 2.0 : isBal ? 1.5 : 1.0
cooldownBars = isCustom ? cCooldown : isLoose ? 1 : isBal ? 3 : 5
minRangeAtr = isCustom ? cMinRange : isLoose ? 0.0 : isBal ? 0.5 : 1.0
maxSignals = isCustom ? cMaxSignals : isLoose ? 8 : isBal ? 6 : 4

atrV = ta.atr(14)
volMA = ta.sma(volume, volLen)
posBars = math.max(3, int(posMinutes / math.max(timeframe.multiplier, 1)))

// ── Range window ──────────────────────────────────────────────────────────────
h = hour(time, tzIn)
m = minute(time, tzIn)
minsOfDay = h * 60 + m
startMin = rangeHour * 60
endMin = startMin + rangeMinutes
inRange = minsOfDay >= startMin and minsOfDay < endMin
afterRange = minsOfDay >= endMin and minsOfDay < endMin + activeHours * 60

newDay = dayofmonth(time, tzIn) != dayofmonth(time[1], tzIn)

var float rHigh = na
var float rLow = na
var bool rSet = false
var bool brokeUp = false
var bool brokeDn = false
var int sigCount = 0
var int lastSigBar = -9999
var int rStartBar = na
var line lnHi = na
var line lnLo = na
var box bxRange = na

if newDay
    rHigh := na
    rLow := na
    rSet := false
    brokeUp := false
    brokeDn := false
    sigCount := 0

if inRange and not inRange[1]
    rStartBar := bar_index

if inRange
    rHigh := na(rHigh) ? high : math.max(rHigh, high)
    rLow := na(rLow) ? low : math.min(rLow, low)

rangeJustClosed = not inRange and inRange[1] and not na(rHigh) and not na(rLow)

if rangeJustClosed
    rSet := true
    lnHi := line.new(rStartBar, rHigh, bar_index, rHigh, color=color.new(color.red, 0), width=2)
    lnLo := line.new(rStartBar, rLow, bar_index, rLow, color=color.new(color.teal, 0), width=2)
    if showLevels
        bxRange := box.new(rStartBar, rHigh, bar_index, rLow, border_color=color.new(color.gray, 60), bgcolor=color.new(color.blue, 88))

if rSet and not na(lnHi)
    line.set_x2(lnHi, bar_index)
    line.set_x2(lnLo, bar_index)

// ── Shared filters ────────────────────────────────────────────────────────────
rangeHeight = rHigh - rLow
rangeWideEnough = not na(rangeHeight) and (minRangeAtr <= 0 or rangeHeight >= atrV * minRangeAtr)

barRng = high - low
bodyOk = minBodyPct <= 0 or (barRng > 0 and math.abs(close - open) / barRng >= minBodyPct / 100)
volOk = not useVol or volume > volMA * volMult
cooled = bar_index - lastSigBar >= cooldownBars
underCap = maxSignals == 0 or sigCount < maxSignals

baseOk = rSet and not inRange and afterRange and rangeWideEnough and volOk and bodyOk and cooled and underCap

bullCandle = close > open
bearCandle = close < open

// Higher-timeframe trend gate (previous completed HTF bar -> no repainting)
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_on)
htfBuyOk = not useHtf or close > htfEma
htfSellOk = not useHtf or close < htfEma

// ── Patterns ──────────────────────────────────────────────────────────────────
penOkLow = (rLow - low) >= atrV * minWickAtr
penOkHigh = (high - rHigh) >= atrV * minWickAtr

bounceLowRaw = low < rLow and close > rLow and penOkLow and (not reqDirCandle or bullCandle)
bounceHighRaw = high > rHigh and close < rHigh and penOkHigh and (not reqDirCandle or bearCandle)
bounceLowOk = bounceLowRaw and (not noBounceAfterBreak or not brokeDn)
bounceHighOk = bounceHighRaw and (not noBounceAfterBreak or not brokeUp)

breakDownRaw = close < rLow - atrV * minBreakAtr and close[1] >= rLow and (not reqDirCandle or bearCandle)
breakUpRaw = close > rHigh + atrV * minBreakAtr and close[1] <= rHigh and (not reqDirCandle or bullCandle)

reentryShortRaw = brokeUp and close[1] > rHigh and close < rHigh and close > rLow and (not reqDirCandle or bearCandle)
reentryLongRaw = brokeDn and close[1] < rLow and close > rLow and close < rHigh and (not reqDirCandle or bullCandle)

// ── Order geometry ────────────────────────────────────────────────────────────
// The stop is CAPPED at maxRisk ATR from entry rather than always sitting back
// at the level. A huge breakout candle therefore yields a tradeable order
// instead of a rejected one, which is what "no signals during a strong trend"
// was really about.
f_rr(entry, tp, sl) =>
    risk = math.abs(entry - sl)
    risk > 0 ? math.abs(tp - entry) / risk : 0.0

f_okBuy(entry, tp, sl) => tp > entry and sl < entry and f_rr(entry, tp, sl) >= minRR
f_okSell(entry, tp, sl) => tp < entry and sl > entry and f_rr(entry, tp, sl) >= minRR

riskCap = atrV * maxRiskAtr

bbTp = rHigh
bbSl = math.max(rLow - atrV * slAtrBuf, close - riskCap)
sbTp = rLow
sbSl = math.min(rHigh + atrV * slAtrBuf, close + riskCap)
// Break targets project from the ENTRY so reward does not shrink as price runs
bkUpTp = close + rangeHeight * breakTpMult
bkUpSl = math.max(rHigh - atrV * slAtrBuf, close - riskCap)
bkDnTp = close - rangeHeight * breakTpMult
bkDnSl = math.min(rLow + atrV * slAtrBuf, close + riskCap)

geomBuyBounce = f_okBuy(close, bbTp, bbSl)
geomSellBounce = f_okSell(close, sbTp, sbSl)
geomBuyBreak = f_okBuy(close, bkUpTp, bkUpSl)
geomSellBreak = f_okSell(close, bkDnTp, bkDnSl)

// Priority: re-entry > break > bounce, so one bar never emits two signals
isBuyReentry = baseOk and htfBuyOk and useReentry and reentryLongRaw and geomBuyBounce
isSellReentry = baseOk and htfSellOk and useReentry and reentryShortRaw and geomSellBounce
isBuyBreak = baseOk and htfBuyOk and useBreak and breakUpRaw and geomBuyBreak and not isBuyReentry and not isSellReentry
isSellBreak = baseOk and htfSellOk and useBreak and breakDownRaw and geomSellBreak and not isBuyReentry and not isSellReentry
isBuyBounce = baseOk and htfBuyOk and useBounce and bounceLowOk and geomBuyBounce and not isBuyReentry and not isSellReentry and not isBuyBreak and not isSellBreak
isSellBounce = baseOk and htfSellOk and useBounce and bounceHighOk and geomSellBounce and not isBuyReentry and not isSellReentry and not isBuyBreak and not isSellBreak

buySignal = isBuyBounce or isBuyBreak or isBuyReentry
sellSignal = isSellBounce or isSellBreak or isSellReentry

rawBuy = (useBounce and bounceLowOk) or (useBreak and breakUpRaw) or (useReentry and reentryLongRaw)
rawSell = (useBounce and bounceHighOk) or (useBreak and breakDownRaw) or (useReentry and reentryShortRaw)
rrBuyVal = breakUpRaw ? f_rr(close, bkUpTp, bkUpSl) : f_rr(close, bbTp, bbSl)
rrSellVal = breakDownRaw ? f_rr(close, bkDnTp, bkDnSl) : f_rr(close, sbTp, sbSl)
rrVal = rawBuy ? rrBuyVal : rrSellVal

if rSet and close < rLow
    brokeDn := true
if rSet and close > rHigh
    brokeUp := true

// ── Drawing ───────────────────────────────────────────────────────────────────
f_mark(isBuy, txt, tp, sl) =>
    col = isBuy ? color.teal : color.red
    entry = close
    rr = f_rr(entry, tp, sl)
    arrow = isBuy ? "▲ " : "▼ "
    body = compactLabels ? arrow + (isBuy ? "BUY" : "SELL") : arrow + txt + "\nTP " + str.tostring(tp, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "\nR:R " + str.tostring(rr, "#.0")
    yPos = isBuy ? low - atrV * 0.6 : high + atrV * 0.6
    label.new(bar_index, yPos, body, style=isBuy ? label.style_label_up : label.style_label_down, color=color.new(col, 10), textcolor=color.white, size=size.small)
    if showPosition
        l = bar_index
        r = bar_index + posBars
        box.new(l, math.max(tp, entry), r, math.min(tp, entry), border_color=color.new(color.teal, 70), bgcolor=color.new(color.teal, 88))
        box.new(l, math.max(entry, sl), r, math.min(entry, sl), border_color=color.new(color.red, 70), bgcolor=color.new(color.red, 88))
        line.new(l, entry, r, entry, color=color.new(col, 0), width=1)
        trimPx = entry + (tp - entry) * trimAtPct / 100
        line.new(l, trimPx, r, trimPx, color=color.new(color.orange, 20), style=line.style_dotted, width=1)
        label.new(r, trimPx, "Trim " + str.tostring(trimSizePct, "#") + "%", style=label.style_label_left, color=color.new(color.orange, 30), textcolor=color.white, size=size.tiny)

if isBuyReentry
    f_mark(true, "BUY failed break", bbTp, bbSl)
    sigCount := sigCount + 1
    lastSigBar := bar_index
if isSellReentry
    f_mark(false, "SELL failed break", sbTp, sbSl)
    sigCount := sigCount + 1
    lastSigBar := bar_index
if isBuyBreak
    f_mark(true, "BUY break", bkUpTp, bkUpSl)
    sigCount := sigCount + 1
    lastSigBar := bar_index
if isSellBreak
    f_mark(false, "SELL break", bkDnTp, bkDnSl)
    sigCount := sigCount + 1
    lastSigBar := bar_index
if isBuyBounce
    f_mark(true, "BUY bounce", bbTp, bbSl)
    sigCount := sigCount + 1
    lastSigBar := bar_index
if isSellBounce
    f_mark(false, "SELL bounce", sbTp, sbSl)
    sigCount := sigCount + 1
    lastSigBar := bar_index

// ── Blocked setups ────────────────────────────────────────────────────────────
blocked = (rawBuy or rawSell) and not buySignal and not sellSignal and rSet and afterRange
why = not rangeWideEnough ? "range too narrow" : not volOk ? "low volume" : not bodyOk ? "weak body" : not cooled ? "cooldown" : not underCap ? "daily cap" : "R:R " + str.tostring(rrVal, "#.2")
if showBlocked and blocked
    label.new(bar_index, rawBuy ? low : high, why, style=rawBuy ? label.style_label_up : label.style_label_down, color=color.new(color.gray, 40), textcolor=color.white, size=size.tiny)

// ── Trade tracking: follow each signal to its outcome and score it in R ──────
// One position at a time, which is how it would actually be traded. A trade
// that never reaches its target and gets stopped is a loss; one that runs out
// of session is closed at market and scored on what it actually made.
var bool inTrade = false
var bool tIsBuy = false
var float tEntry = na
var float tSl = na
var float tTp = na
var float tTrim = na
var float tRisk = na
var bool tTrimmed = false
var int tBar = na
var int nTrades = 0
var int nWins = 0
var int nLosses = 0
var int nExpired = 0
var int nTrimHit = 0
var float sumR = 0.0

newSignal = buySignal or sellSignal
if newSignal and not inTrade
    inTrade := true
    tIsBuy := buySignal
    tEntry := close
    tSl := isBuyReentry or isBuyBounce ? bbSl : isSellReentry or isSellBounce ? sbSl : isBuyBreak ? bkUpSl : bkDnSl
    tTp := isBuyReentry or isBuyBounce ? bbTp : isSellReentry or isSellBounce ? sbTp : isBuyBreak ? bkUpTp : bkDnTp
    tTrim := tEntry + (tTp - tEntry) * trimAtPct / 100
    tRisk := math.abs(tEntry - tSl)
    tTrimmed := false
    tBar := bar_index
    nTrades := nTrades + 1

if inTrade and bar_index > tBar
    trimFrac = trimSizePct / 100
    fullR = tRisk > 0 ? math.abs(tTp - tEntry) / tRisk : 0.0
    trimR = fullR * trimAtPct / 100
    // Stop is checked before target: assume the adverse move came first
    hitSl = tIsBuy ? low <= tSl : high >= tSl
    hitTp = tIsBuy ? high >= tTp : low <= tTp
    hitTrim = tIsBuy ? high >= tTrim : low <= tTrim

    if hitTrim and not tTrimmed and not hitSl
        tTrimmed := true
        nTrimHit := nTrimHit + 1
        if beAfterTrim
            tSl := tEntry

    if hitSl
        // Stopped. If already trimmed, the banked partial still counts.
        rNow = tTrimmed ? trimFrac * trimR + (1 - trimFrac) * (tSl == tEntry ? 0.0 : -1.0) : -1.0
        sumR := sumR + rNow
        if rNow > 0
            nWins := nWins + 1
        else
            nLosses := nLosses + 1
        inTrade := false
    else if hitTp
        rNow = tTrimmed ? trimFrac * trimR + (1 - trimFrac) * fullR : fullR
        sumR := sumR + rNow
        nWins := nWins + 1
        inTrade := false
    else if newDay or not afterRange
        // Session over and the trade never resolved — close it out and score it
        moved = tIsBuy ? close - tEntry : tEntry - close
        rNow = tRisk > 0 ? moved / tRisk : 0.0
        rNow := tTrimmed ? trimFrac * trimR + (1 - trimFrac) * rNow : rNow
        sumR := sumR + rNow
        nExpired := nExpired + 1
        if rNow > 0
            nWins := nWins + 1
        else
            nLosses := nLosses + 1
        inTrade := false

// ── Results table ─────────────────────────────────────────────────────────────
var table stats = na
if showStats and barstate.islast
    table.delete(stats)
    stats := table.new(position.top_right, 2, 7, border_width=1, frame_width=1, frame_color=color.new(color.gray, 60))
    winPct = nTrades > 0 ? nWins / nTrades * 100 : 0.0
    trimPct2 = nTrades > 0 ? nTrimHit / nTrades * 100 : 0.0
    expectancy = nTrades > 0 ? sumR / nTrades : 0.0
    netCol = sumR > 0 ? color.teal : color.red
    table.cell(stats, 0, 0, "RESULTS", text_color=color.gray, bgcolor=color.new(color.black, 70), text_size=size.small)
    table.cell(stats, 1, 0, "", bgcolor=color.new(color.black, 70))
    table.cell(stats, 0, 1, "Trades", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stats, 1, 1, str.tostring(nTrades), text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stats, 0, 2, "Win rate", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stats, 1, 2, str.tostring(winPct, "#.0") + "%", text_color=winPct >= 50 ? color.teal : color.orange, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stats, 0, 3, "W / L", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stats, 1, 3, str.tostring(nWins) + " / " + str.tostring(nLosses), text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stats, 0, 4, "Trim hit", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stats, 1, 4, str.tostring(trimPct2, "#.0") + "%", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stats, 0, 5, "Unresolved", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stats, 1, 5, str.tostring(nExpired), text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stats, 0, 6, "Net R / avg", text_color=color.white, bgcolor=color.new(color.black, 70), text_size=size.small)
    table.cell(stats, 1, 6, str.tostring(sumR, "#.1") + "R / " + str.tostring(expectancy, "#.2") + "R", text_color=netCol, bgcolor=color.new(color.black, 70), text_size=size.small)

// ── Alerts ────────────────────────────────────────────────────────────────────
alertcondition(isBuyReentry, "BUY failed break", "BUY — failed breakdown, back inside range on {{ticker}} @ {{close}}")
alertcondition(isSellReentry, "SELL failed break", "SELL — failed breakout, back inside range on {{ticker}} @ {{close}}")
alertcondition(isBuyBreak, "BUY break", "BUY — broke ABOVE range HIGH on {{ticker}} @ {{close}}")
alertcondition(isSellBreak, "SELL break", "SELL — broke BELOW range LOW on {{ticker}} @ {{close}}")
alertcondition(isBuyBounce, "BUY bounce", "BUY — bounced off range LOW on {{ticker}} @ {{close}}")
alertcondition(isSellBounce, "SELL bounce", "SELL — bounced off range HIGH on {{ticker}} @ {{close}}")
alertcondition(buySignal, "Any BUY", "BUY signal on {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(sellSignal, "Any SELL", "SELL signal on {{ticker}} ({{interval}}) @ {{close}}")
