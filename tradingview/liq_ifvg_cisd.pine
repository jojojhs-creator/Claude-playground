//@version=5
// Liquidity Sweep + IFVG + CISD
//
//   1. SWEEP — price takes out a prior swing. Each pool is used once.
//   2. CISD — a close back through the open of the first candle of the last
//      opposing run means delivery has flipped.
//   3. IFVG — a 3-bar gap that gets closed through flips polarity and acts as
//      support/resistance from the other side.
//
// Two premises, each independently toggleable:
//   REVERSAL     — liquidity taken, price turns back. Stop beyond the extreme.
//   CONTINUATION — liquidity taken and price HOLDS beyond it. Stop back at the
//                  level, since falling inside proves the breakout failed.
//
// The TARGET can come from the chart instead of a fixed multiple:
//   ATR multiple        risk x RR. Blind — it demands the same multiple whether
//                       or not price has anywhere to go.
//   Next liquidity pool the nearest unswept swing the other side of entry.
//                       Resting stops are what actually draws price.
//   Day range           the 24h high/low. The right target in a rotation.
// A structural target that is closer than the minimum R:R DECLINES the setup
// rather than inventing a target to fit the ratio. Stops are unchanged — they
// were always structural, anchored to the sweep itself.
//
// The impact filter reads how far the last 24h has already travelled against a
// normal day, so a late entry into a spent session can be skipped.
//
// Chart hygiene: every drawing belonging to a trade is tracked, so a finished
// or superseded setup can be erased instead of accumulating forever.
//
// Signals evaluate on CLOSED bars — set alerts to "Once Per Bar Close".

indicator("Liquidity Sweep + IFVG + CISD", shorttitle="Liq+IFVG+CISD", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ── Preset ────────────────────────────────────────────────────────────────────
preset = input.string("Auto (by timeframe)", "Settings", options=["Auto (by timeframe)", "Manual"], group="Preset", tooltip="Auto tightens every threshold as the chart speeds up. Manual uses the numbers you set below and ignores the timeframe.")
strictness = input.string("Balanced", "Strictness", options=["Loose", "Balanced", "Strict"], group="Preset", tooltip="Shifts the whole Auto preset without touching the timeframe logic. Loose trades more and filters less. Set it per chart — a quiet M1 can run Loose while M15 stays Balanced.")

// ── Liquidity ─────────────────────────────────────────────────────────────────
pivotLen = input.int(8, "Swing lookback for liquidity", minval=2, group="Liquidity")
maxPools = input.int(6, "Liquidity pools tracked per side", minval=1, maxval=20, group="Liquidity")
requireCloseBack = input.bool(false, "Sweep candle must also close back inside", group="Liquidity")
armBars = input.int(12, "Setup stays armed for (bars)", minval=1, group="Liquidity")
tradeReversal = input.bool(true, "Trade REVERSALS (sweep high -> short)", group="Liquidity")
tradeCont = input.bool(true, "Trade CONTINUATIONS (sweep high, hold above -> long)", group="Liquidity")

// ── CISD ──────────────────────────────────────────────────────────────────────
minRunLen = input.int(2, "Min candles in the opposing run", minval=1, group="CISD")

// ── IFVG ──────────────────────────────────────────────────────────────────────
useIfvg = input.bool(false, "Require price inside an IFVG to enter", group="IFVG")
maxFvg = input.int(6, "Track this many recent gaps", minval=1, maxval=30, group="IFVG")
minFvgAtr = input.float(0.25, "Ignore gaps smaller than (x ATR)", minval=0.0, step=0.05, group="IFVG")
fvgExtend = input.int(40, "Stop extending a zone after (bars)", minval=5, group="IFVG")

// ── Risk ──────────────────────────────────────────────────────────────────────
slBufAtr = input.float(0.25, "Stop beyond the level (x ATR)", minval=0.0, step=0.05, group="Risk")
stopRoom = input.float(1.0, "Stop room x  (widens the whole stop)", minval=0.5, maxval=3.0, step=0.1, group="Risk", tooltip="Scales the buffer, the floor and the ceiling together. Raise it when price keeps wicking through your stop and then running your way. Check the 'Stopped, then TP' row before and after — that is the number this is meant to shrink.")
maxRiskAtr = input.float(1.5, "Cap risk at (x ATR from entry)", minval=0.3, step=0.1, group="Risk")
minRiskAtr = input.float(0.5, "Floor risk at (x ATR from entry, 0 = off)", minval=0.0, step=0.05, group="Risk", tooltip="A continuation entry sits right next to the level it just broke, so the structural stop can land inside one candle of noise. This widens it to something the market cannot hit by accident. Capped by the maximum above.")
tpMode = input.string("Next liquidity pool", "Target taken from", options=["ATR multiple", "Next liquidity pool", "Day range"], group="Risk", tooltip="ATR multiple ignores the chart. The other two read a real level off it and will decline the trade if that level is too close.")
rrMult = input.float(2.0, "  ATR mode: target = risk x", minval=0.5, step=0.5, group="Risk")
minRR = input.float(1.0, "  Structural: skip if target is closer than (R)", minval=0.1, step=0.1, group="Risk")
maxStructRR = input.float(5.0, "  Structural: cap target at (R)", minval=1.0, step=0.5, group="Risk", tooltip="Risk is already capped, so an uncapped target lets the nearest unswept pool sit a day's range away while the stop sits inside one bar of noise. Those resolve on different clocks and the stop always wins.")
tpBufAtr = input.float(0.10, "  Structural: take profit before the level (x ATR)", minval=0.0, step=0.05, group="Risk")
maxAdrUsed = input.float(0.0, "Skip when 24h range exceeds (x normal, 0 = off)", minval=0.0, step=0.1, group="Risk", tooltip="1.0 is an average day. At 1.3 the session has already run 30% further than usual and is unlikely to pay out a fresh target.")
adrDays = input.int(14, "  Days used for the normal range", minval=3, group="Risk")
cooldownBars = input.int(5, "Min bars between signals", minval=0, group="Risk")
confirmedOnly = input.bool(true, "Only signal on closed candles", group="Risk")

// ── Chart ─────────────────────────────────────────────────────────────────────
hidePast = input.bool(true, "Hide the previous signal when a new one fires", group="Chart")
hideDone = input.bool(false, "Also hide a signal once its TP or SL is hit", group="Chart")
showLiq = input.bool(true, "Live liquidity levels", group="Chart")
showSweepMark = input.bool(true, "Mark sweeps", group="Chart")
maxSweepMarks = input.int(3, "Keep only this many sweep marks", minval=1, maxval=20, group="Chart")
showIfvg = input.bool(true, "IFVG zones", group="Chart")
showIfvgLabel = input.bool(false, "Label each IFVG", group="Chart")
showFreshFvg = input.bool(false, "Also show fresh gaps — noisy", group="Chart")
showPending = input.bool(true, "Live CISD level while armed", group="Chart")
showPosBox = input.bool(true, "Shade the position", group="Chart")
tradeBars = input.int(30, "Trade line length (bars)", minval=5, group="Chart")
showStats = input.bool(true, "Results table", group="Chart")
tablePos = input.string("Top right", "Table position", options=["Top right", "Bottom right", "Top left", "Bottom left", "Middle right"], group="Chart")
spreadPx = input.float(0.30, "Spread, in price (0 = ignore costs)", minval=0.0, step=0.01, group="Chart", tooltip="Charged against every trade. Gold is about 0.25-0.30. This is the single biggest cost in the model and leaving it out is what makes a losing setup look breakeven — a tight stop pays a far larger share of its risk in spread than a wide one.")
watchBars = input.int(60, "Measure: bars watched after a stop", minval=5, group="Chart", tooltip="After a stop-out, keep watching this many bars to see whether the original target would have been reached anyway. A high 'Stopped, then TP' count means the stop is too tight — the read was right and the stop was in the noise.")

// ── Alerts ────────────────────────────────────────────────────────────────────
alertFmt = input.string("Plain text", "Alert format", options=["Plain text", "Telegram JSON"], group="Alerts", tooltip="Telegram JSON builds the exact body Telegram's API expects, so a TradingView webhook can post straight to your chat with no server in between.")
tgChatId = input.string("", "Telegram chat id", group="Alerts", tooltip="Only the chat id goes here. Your bot TOKEN belongs in the webhook URL in the alert dialog, never in the script.")

// ── Timeframe preset ──────────────────────────────────────────────────────────
// A faster chart is a noisier one, and it pays a far larger share of its risk in
// spread — roughly 18% on M1 against 2.5% on M15. So the model has to ask for
// more before it acts. Every value below tightens as the timeframe drops:
// bigger swings, longer runs, longer cooldowns, a wider stop floor, a nearer
// target cap, and a higher minimum reward to clear the cost.
tfMin = timeframe.in_seconds() / 60
autoTf = preset == "Auto (by timeframe)"

// Base ladder, then the strictness dial shifts all of it at once.
//                    M1     M5     M15    M30+
bPiv      = tfMin <= 1 ?  20  : tfMin <= 5 ?  14  : tfMin <= 15 ?  10  :  8
bArm      = tfMin <= 1 ?  10  : tfMin <= 5 ?  12  : tfMin <= 15 ?  12  : 12
bRun      = tfMin <= 1 ?   4  : tfMin <= 5 ?   3  : tfMin <= 15 ?   2  :  2
bCool     = tfMin <= 1 ?  20  : tfMin <= 5 ?  12  : tfMin <= 15 ?   6  :  4
bMinRisk  = tfMin <= 1 ? 1.00 : tfMin <= 5 ? 0.80 : tfMin <= 15 ? 0.50 : 0.50
bMaxRR    = tfMin <= 1 ? 3.00 : tfMin <= 5 ? 4.00 : tfMin <= 15 ? 5.00 : 6.00
bMinRR    = tfMin <= 1 ? 1.80 : tfMin <= 5 ? 1.50 : tfMin <= 15 ? 1.20 : 1.00
bAdr      = tfMin <= 1 ? 1.15 : tfMin <= 5 ? 1.25 : tfMin <= 15 ? 1.40 : 0.00
// A sweep that closes back inside is a stricter definition of a trap. Worth
// demanding where noise dominates; Loose drops it since it is a heavy filter.
bCloseBack = tfMin <= 5

loose = strictness == "Loose"
tight = strictness == "Strict"
kPiv   = loose ? 0.70 : tight ? 1.30 : 1.00     // smaller swings count
kArm   = loose ? 1.40 : tight ? 0.80 : 1.00     // longer to act on a sweep
kCool  = loose ? 0.55 : tight ? 1.50 : 1.00     // less waiting between signals
dRun   = loose ?   -1 : tight ?    1 : 0        // shorter run counts as a CISD
dMinRR = loose ? -0.40: tight ? 0.30 : 0.0      // accept a nearer target
dAdr   = loose ?  0.20: tight ?-0.10 : 0.0      // tolerate a busier day

pivotLenX        = autoTf ? math.max(3, int(math.round(bPiv * kPiv)))  : pivotLen
armBarsX         = autoTf ? math.max(3, int(math.round(bArm * kArm)))  : armBars
minRunLenX       = autoTf ? math.max(1, bRun + dRun)                   : minRunLen
cooldownBarsX    = autoTf ? math.max(0, int(math.round(bCool * kCool))): cooldownBars
minRiskAtrX      = autoTf ? bMinRisk                                   : minRiskAtr
maxStructRRX     = autoTf ? bMaxRR                                     : maxStructRR
minRRX           = autoTf ? math.max(0.5, bMinRR + dMinRR)             : minRR
maxAdrUsedX      = autoTf ? (bAdr <= 0 ? 0.0 : math.max(1.0, bAdr + dAdr)) : maxAdrUsed
requireCloseBackX = autoTf ? (loose ? false : bCloseBack) : requireCloseBack

// Stop room scales the buffer, the floor and the ceiling together, so raising
// it cannot leave the floor fighting the ceiling.
slBufE   = slBufAtr * stopRoom
minRiskE = minRiskAtrX * stopRoom
maxRiskE = maxRiskAtr * stopRoom

tfName = tfMin <= 1 ? "M1" : tfMin <= 5 ? "M5" : tfMin <= 15 ? "M15" : "M30+"

atrV = ta.atr(14)

// ── How stretched is the session already ──────────────────────────────────────
// A rolling 24h window rather than the daily bar, so nothing has to be pulled
// from a higher timeframe and there is no repainting to reason about.
barsPerDay = math.max(4, math.round(1440 / math.max(1, timeframe.in_seconds() / 60)))
adrLen = math.min(2000, barsPerDay * adrDays)
dayHi = ta.highest(high, barsPerDay)
dayLo = ta.lowest(low, barsPerDay)
dayRange = dayHi - dayLo
adrTypical = ta.sma(dayRange, adrLen)
dayStretch = adrTypical > 0 ? dayRange / adrTypical : float(na)
adrOk = maxAdrUsedX <= 0 or na(dayStretch) or dayStretch <= maxAdrUsedX

// ── Liquidity pools ───────────────────────────────────────────────────────────
ph = ta.pivothigh(high, pivotLenX, pivotLenX)
pl = ta.pivotlow(low, pivotLenX, pivotLenX)

var array<float> poolHi = array.new_float()
var array<float> poolLo = array.new_float()
var array<line> poolHiLn = array.new_line()
var array<line> poolLoLn = array.new_line()

// A pivot confirms pivotLenX bars late; if price already went through it in that
// window the pool was gone before we could ever use it.
if not na(ph) and ta.highest(high, pivotLenX) <= ph
    array.push(poolHi, ph)
    array.push(poolHiLn, showLiq ? line.new(bar_index - pivotLenX, ph, bar_index, ph, color=color.new(color.red, 60), style=line.style_dashed, width=1) : na)
    while array.size(poolHi) > maxPools
        dl = array.shift(poolHiLn)
        if not na(dl)
            line.delete(dl)
        array.shift(poolHi)

if not na(pl) and ta.lowest(low, pivotLenX) >= pl
    array.push(poolLo, pl)
    array.push(poolLoLn, showLiq ? line.new(bar_index - pivotLenX, pl, bar_index, pl, color=color.new(color.teal, 60), style=line.style_dashed, width=1) : na)
    while array.size(poolLo) > maxPools
        dl2 = array.shift(poolLoLn)
        if not na(dl2)
            line.delete(dl2)
        array.shift(poolLo)

sweptHigh = false
sweptLow = false
var float sweepHighPx = na
var float sweepLowPx = na
var float sweptHiLvl = na
var float sweptLoLvl = na
var int armedBearBar = -9999
var int armedBullBar = -9999

if array.size(poolHi) > 0
    for i = array.size(poolHi) - 1 to 0
        if i < array.size(poolHi)
            lvl = array.get(poolHi, i)
            if high > lvl and (not requireCloseBackX or close < lvl)
                sweptHigh := true
                sweepHighPx := high
                sweptHiLvl := lvl
                dl3 = array.get(poolHiLn, i)
                if not na(dl3)
                    line.delete(dl3)
                array.remove(poolHi, i)
                array.remove(poolHiLn, i)
            else if not na(array.get(poolHiLn, i))
                line.set_x2(array.get(poolHiLn, i), bar_index)

if array.size(poolLo) > 0
    for j = array.size(poolLo) - 1 to 0
        if j < array.size(poolLo)
            lvl2 = array.get(poolLo, j)
            if low < lvl2 and (not requireCloseBackX or close > lvl2)
                sweptLow := true
                sweepLowPx := low
                sweptLoLvl := lvl2
                dl4 = array.get(poolLoLn, j)
                if not na(dl4)
                    line.delete(dl4)
                array.remove(poolLo, j)
                array.remove(poolLoLn, j)
            else if not na(array.get(poolLoLn, j))
                line.set_x2(array.get(poolLoLn, j), bar_index)

// Only the most recent sweep marks are kept
var array<label> sweepLbls = array.new_label()
if sweptHigh
    armedBearBar := bar_index
    if showSweepMark
        array.push(sweepLbls, label.new(bar_index, high, "SWEEP", style=label.style_label_down, color=color.new(color.red, 30), textcolor=color.white, size=size.tiny))
if sweptLow
    armedBullBar := bar_index
    if showSweepMark
        array.push(sweepLbls, label.new(bar_index, low, "SWEEP", style=label.style_label_up, color=color.new(color.teal, 30), textcolor=color.white, size=size.tiny))
while array.size(sweepLbls) > maxSweepMarks
    label.delete(array.shift(sweepLbls))

bullArmed = bar_index - armedBullBar <= armBarsX
bearArmed = bar_index - armedBearBar <= armBarsX

// ── CISD ──────────────────────────────────────────────────────────────────────
isDn = close < open
isUp = close > open

var float curDnOpen = na
var int curDnLen = 0
var float curUpOpen = na
var int curUpLen = 0
var float cisdBullLevel = na
var float cisdBearLevel = na

if isDn
    if not isDn[1]
        curDnOpen := open
        curDnLen := 1
    else
        curDnLen := curDnLen + 1
if isUp
    if not isUp[1]
        curUpOpen := open
        curUpLen := 1
    else
        curUpLen := curUpLen + 1

if isUp and isDn[1] and curDnLen >= minRunLenX and not na(curDnOpen)
    cisdBullLevel := curDnOpen
if isDn and isUp[1] and curUpLen >= minRunLenX and not na(curUpOpen)
    cisdBearLevel := curUpOpen

cisdBull = not na(cisdBullLevel) and close > cisdBullLevel and close[1] <= cisdBullLevel
cisdBear = not na(cisdBearLevel) and close < cisdBearLevel and close[1] >= cisdBearLevel

// Level to reclaim, shown live while a setup is armed
var line lnPend = na
var label lbPend = na
pendIsBull = bullArmed and not na(cisdBullLevel)
pendIsBear = bearArmed and not na(cisdBearLevel)
pendLvl = pendIsBull ? cisdBullLevel : pendIsBear ? cisdBearLevel : na

if showPending
    line.delete(lnPend)
    label.delete(lbPend)
    if not na(pendLvl)
        pcol = pendIsBull ? color.teal : color.red
        pFrom = pendIsBull ? armedBullBar : armedBearBar
        lnPend := line.new(pFrom, pendLvl, bar_index + 4, pendLvl, color=color.new(pcol, 30), style=line.style_dotted, width=2)
        lbPend := label.new(bar_index + 4, pendLvl, "CISD " + str.tostring(pendLvl, format.mintick), style=label.style_label_left, color=color.new(pcol, 60), textcolor=color.white, size=size.tiny)

// ── Gaps, drawn only once they invert ────────────────────────────────────────
var array<float> fTop = array.new_float()
var array<float> fBot = array.new_float()
var array<int> fDir = array.new_int()
var array<bool> fInv = array.new_bool()
var array<int> fBar = array.new_int()
var array<box> fBox = array.new_box()

bullGap = low > high[2] and (low - high[2]) >= atrV * minFvgAtr
bearGap = high < low[2] and (low[2] - high) >= atrV * minFvgAtr

if bullGap
    array.push(fTop, low)
    array.push(fBot, high[2])
    array.push(fDir, 1)
    array.push(fInv, false)
    array.push(fBar, bar_index)
    array.push(fBox, showFreshFvg ? box.new(bar_index - 2, low, bar_index, high[2], border_color=color.new(color.gray, 85), bgcolor=color.new(color.teal, 95)) : na)
if bearGap
    array.push(fTop, low[2])
    array.push(fBot, high)
    array.push(fDir, -1)
    array.push(fInv, false)
    array.push(fBar, bar_index)
    array.push(fBox, showFreshFvg ? box.new(bar_index - 2, low[2], bar_index, high, border_color=color.new(color.gray, 85), bgcolor=color.new(color.red, 95)) : na)

while array.size(fTop) > maxFvg
    ob = array.shift(fBox)
    if not na(ob)
        box.delete(ob)
    array.shift(fTop)
    array.shift(fBot)
    array.shift(fDir)
    array.shift(fInv)
    array.shift(fBar)

inBullIfvg = false
inBearIfvg = false
if array.size(fTop) > 0
    for k = 0 to array.size(fTop) - 1
        ft = array.get(fTop, k)
        fb = array.get(fBot, k)
        fd = array.get(fDir, k)
        fi = array.get(fInv, k)
        fx = array.get(fBox, k)
        stb = array.get(fBar, k)
        if not fi
            violated = fd == 1 ? close < fb : close > ft
            if violated
                array.set(fInv, k, true)
                if showIfvg
                    bull = fd == -1
                    col = bull ? color.teal : color.orange
                    if na(fx)
                        fx := box.new(bar_index, ft, bar_index + 1, fb, border_color=color.new(col, 40), bgcolor=color.new(col, 88), border_width=1)
                        array.set(fBox, k, fx)
                    else
                        box.set_bgcolor(fx, color.new(col, 88))
                        box.set_border_color(fx, color.new(col, 40))
                    if showIfvgLabel
                        label.new(bar_index, bull ? fb : ft, "IFVG", style=bull ? label.style_label_up : label.style_label_down, color=color.new(col, 40), textcolor=color.white, size=size.tiny)
        else
            if fd == -1 and low <= ft and high >= fb
                inBullIfvg := true
            if fd == 1 and high >= ft and low <= fb
                inBearIfvg := true
        if not na(fx) and bar_index - stb <= fvgExtend
            box.set_right(fx, bar_index + 1)

// ── Entry ─────────────────────────────────────────────────────────────────────
// Nearest untouched pool on the far side of price. Swept pools are already
// removed from these arrays above, so what is left is genuinely unclaimed.
f_nearestAbove(arr, px) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v > px and (na(best) or v < best)
                best := v
    best

f_nearestBelow(arr, px) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v < px and (na(best) or v > best)
                best := v
    best

var int lastSigBar = -9999
cooled = bar_index - lastSigBar >= cooldownBarsX

ifvgBuyOk = not useIfvg or inBullIfvg
ifvgSellOk = not useIfvg or inBearIfvg

revBuy = tradeReversal and bullArmed and cisdBull and not na(sweepLowPx)
revSell = tradeReversal and bearArmed and cisdBear and not na(sweepHighPx)
contBuy = tradeCont and bearArmed and cisdBull and not na(sweptHiLvl) and close > sweptHiLvl
contSell = tradeCont and bullArmed and cisdBear and not na(sweptLoLvl) and close < sweptLoLvl

rawBuy = (revBuy or contBuy) and cooled and ifvgBuyOk
rawSell = (revSell or contSell) and cooled and ifvgSellOk

buyAnchor = revBuy ? sweepLowPx : sweptHiLvl
sellAnchor = revSell ? sweepHighPx : sweptLoLvl
buySlRaw = math.max(buyAnchor - atrV * slBufE, close - atrV * maxRiskE)
sellSlRaw = math.min(sellAnchor + atrV * slBufE, close + atrV * maxRiskE)

// The floor. maxRiskAtr only ever tightens the stop, so without this a
// continuation entry taken right at the break gets a stop inside bar noise.
floorAtr = math.min(minRiskE, maxRiskE)
buySl = floorAtr > 0 ? math.min(buySlRaw, close - atrV * floorAtr) : buySlRaw
sellSl = floorAtr > 0 ? math.max(sellSlRaw, close + atrV * floorAtr) : sellSlRaw
buyRisk = close - buySl
sellRisk = sellSl - close

// Where the target comes from. The structural ones can return na — that is a
// real answer meaning "the chart is not offering anything", not a failure.
isAtrTp = tpMode == "ATR multiple"
poolTgtBuy = f_nearestAbove(poolHi, close)
poolTgtSell = f_nearestBelow(poolLo, close)

buyTpRaw = isAtrTp ? close + buyRisk * rrMult : tpMode == "Next liquidity pool" ? poolTgtBuy - atrV * tpBufAtr : dayHi - atrV * tpBufAtr
sellTpRaw = isAtrTp ? close - sellRisk * rrMult : tpMode == "Next liquidity pool" ? poolTgtSell + atrV * tpBufAtr : dayLo + atrV * tpBufAtr

// Clamp a structural target to something reachable on the same clock as the stop
buyTp = isAtrTp or na(buyTpRaw) ? buyTpRaw : math.min(buyTpRaw, close + buyRisk * maxStructRRX)
sellTp = isAtrTp or na(sellTpRaw) ? sellTpRaw : math.max(sellTpRaw, close - sellRisk * maxStructRRX)

// How much room the chart is actually giving, in R
buyRoom = buyRisk > 0 and not na(buyTp) ? (buyTp - close) / buyRisk : float(na)
sellRoom = sellRisk > 0 and not na(sellTp) ? (close - sellTp) / sellRisk : float(na)
buyRoomOk = isAtrTp or (not na(buyRoom) and buyRoom >= minRRX)
sellRoomOk = isAtrTp or (not na(sellRoom) and sellRoom >= minRRX)

barOk = not confirmedOnly or barstate.isconfirmed
buyOk = rawBuy and buyRisk > 0 and barOk and buyRoomOk and adrOk
sellOk = rawSell and sellRisk > 0 and barOk and sellRoomOk and adrOk
buySignal = buyOk and not sellOk
sellSignal = sellOk and not buyOk

// Why a valid sweep+CISD did not become a trade — counted, so a quiet chart
// is explainable instead of mysterious.
var int nNoRoom = 0
var int nAdrBlocked = 0
setupReady = (rawBuy or rawSell) and barOk and (buyRisk > 0 or sellRisk > 0)
if setupReady and not adrOk
    nAdrBlocked := nAdrBlocked + 1
if setupReady and adrOk and ((rawBuy and not buyRoomOk) or (rawSell and not sellRoomOk))
    nNoRoom := nNoRoom + 1

// ── Trade state ───────────────────────────────────────────────────────────────
// The signal is decided on a bar's CLOSE, which is not a price anyone can
// transact at. The earliest realistic fill is the NEXT bar's open, so a signal
// is parked for one bar and filled there. Scoring at the signal close flatters
// every number on the results table.
var bool pending = false
var bool pIsBuy = false
var float pSl = na
var float pTp = na
var bool inTrade = false
var bool tIsBuy = false
var float tEntry = na
var float tSl = na
var float tTp = na
var float tR = na
var int nTrades = 0
var int nWins = 0
var int nLosses = 0
var int nGapped = 0
var float sumR = 0.0
var float sumCostR = 0.0
var float tRisk = na

// Was the stop the problem, or was the read wrong? After a stop-out, keep
// watching the original target. If price gets there anyway, the direction was
// right and the stop was sitting in the noise — which is a fixable mistake,
// unlike a bad read.
var bool watching = false
var bool wIsBuy = false
var float wTp = na
var int wBar = 0
var int nStopThenTp = 0

// Only one position at a time, so a signal arriving mid-trade is not taken —
// and must not be drawn either, or the chart shows a trade the table ignores.
canTake = not inTrade and not pending

// ── Drawing, with every object tracked so it can be erased ───────────────────
var array<line> tLines = array.new_line()
var array<label> tLabels = array.new_label()
var array<box> tBoxes = array.new_box()

f_clear() =>
    while array.size(tLines) > 0
        line.delete(array.pop(tLines))
    while array.size(tLabels) > 0
        label.delete(array.pop(tLabels))
    while array.size(tBoxes) > 0
        box.delete(array.pop(tBoxes))

f_draw(isBuy, entry, tp, sl, cisdLvl, kind, room) =>
    col = isBuy ? color.teal : color.red
    x1 = bar_index
    x2 = bar_index + tradeBars
    array.push(tLines, line.new(x1, entry, x2, entry, color=color.new(col, 0), width=2))
    array.push(tLines, line.new(x1, tp, x2, tp, color=color.new(color.teal, 25), style=line.style_dashed, width=1))
    array.push(tLines, line.new(x1, sl, x2, sl, color=color.new(color.red, 25), style=line.style_dashed, width=1))
    array.push(tLabels, label.new(x2, entry, (isBuy ? "▲ BUY " : "▼ SELL ") + kind + " " + str.tostring(entry, format.mintick), style=label.style_label_left, color=color.new(col, 15), textcolor=color.white, size=size.small))
    array.push(tLabels, label.new(x2, tp, "TP " + str.tostring(tp, format.mintick) + (na(room) ? "" : "  " + str.tostring(room, "#.#") + "R"), style=label.style_label_left, color=color.new(color.teal, 45), textcolor=color.white, size=size.tiny))
    array.push(tLabels, label.new(x2, sl, "SL " + str.tostring(sl, format.mintick), style=label.style_label_left, color=color.new(color.red, 45), textcolor=color.white, size=size.tiny))
    if showPosBox
        array.push(tBoxes, box.new(x1, math.max(tp, entry), x2, math.min(tp, entry), border_color=color.new(color.teal, 85), bgcolor=color.new(color.teal, 92)))
        array.push(tBoxes, box.new(x1, math.max(entry, sl), x2, math.min(entry, sl), border_color=color.new(color.red, 85), bgcolor=color.new(color.red, 92)))
    if not na(cisdLvl)
        array.push(tLines, line.new(x1 - 8, cisdLvl, x1 + 2, cisdLvl, color=color.new(col, 20), style=line.style_dotted, width=2))
        array.push(tLabels, label.new(x1 - 8, cisdLvl, "CISD ✓", style=label.style_label_right, color=color.new(col, 40), textcolor=color.white, size=size.tiny))

// alertcondition() messages are frozen at compile time, so they cannot carry a
// price. alert() is evaluated per bar and can.
f_alertText(isBuy, kind, entry, sl, tp, room) =>
    (isBuy ? "BUY " : "SELL ") + kind + " " + syminfo.ticker + " " + timeframe.period +
      "  entry " + str.tostring(entry, format.mintick) +
      "  SL " + str.tostring(sl, format.mintick) +
      "  TP " + str.tostring(tp, format.mintick) +
      (na(room) ? "" : "  (" + str.tostring(room, "#.#") + "R)")

// Telegram's API wants a JSON body, so a webhook can post straight to the chat
// with nothing in between. Single quotes here keep the JSON's double quotes.
f_tablePos() =>
    tablePos == "Bottom right" ? position.bottom_right : tablePos == "Top left" ? position.top_left : tablePos == "Bottom left" ? position.bottom_left : tablePos == "Middle right" ? position.middle_right : position.top_right

f_wrap(txt) =>
    alertFmt == "Telegram JSON" ? '{"chat_id":"' + tgChatId + '","text":"' + txt + '"}' : txt

if buySignal and canTake
    if hidePast
        f_clear()
    f_draw(true, close, buyTp, buySl, cisdBullLevel, revBuy ? "rev" : "cont", buyRoom)
    alert(f_wrap(f_alertText(true, revBuy ? "rev" : "cont", close, buySl, buyTp, buyRoom)), alert.freq_once_per_bar_close)
    lastSigBar := bar_index
if sellSignal and canTake
    if hidePast
        f_clear()
    f_draw(false, close, sellTp, sellSl, cisdBearLevel, revSell ? "rev" : "cont", sellRoom)
    alert(f_wrap(f_alertText(false, revSell ? "rev" : "cont", close, sellSl, sellTp, sellRoom)), alert.freq_once_per_bar_close)
    lastSigBar := bar_index

// ── Outcome tracking ──────────────────────────────────────────────────────────
// Fill first, against THIS bar's open, then test the same bar for an exit —
// a trade can be opened and stopped inside one candle, and pretending
// otherwise hides the losses that hurt most.
if pending and not inTrade
    fillRisk = pIsBuy ? open - pSl : pSl - open
    if fillRisk > 0
        inTrade := true
        tIsBuy := pIsBuy
        tEntry := open
        tSl := pSl
        tTp := pTp
        tR := (pIsBuy ? pTp - open : open - pTp) / fillRisk
        tRisk := fillRisk
        nTrades := nTrades + 1
    else
        nGapped := nGapped + 1      // opened beyond its own stop
    pending := false

if inTrade
    hitSl = tIsBuy ? low <= tSl : high >= tSl
    hitTp = tIsBuy ? high >= tTp : low <= tTp
    if hitSl or hitTp
        // Spread is paid on every trade either way. As a share of R it is far
        // heavier on a tight stop, which is why fast charts bleed.
        costR = spreadPx > 0 and tRisk > 0 ? spreadPx / tRisk : 0.0
        sumCostR := sumCostR + costR
        sumR := sumR + (hitSl ? -1.0 : na(tR) ? rrMult : tR) - costR
        if hitSl
            nLosses := nLosses + 1
            watching := true
            wIsBuy := tIsBuy
            wTp := tTp
            wBar := bar_index
        else
            nWins := nWins + 1
        inTrade := false
        if hideDone
            f_clear()

if watching
    if bar_index - wBar > watchBars
        watching := false
    else if wIsBuy ? high >= wTp : low <= wTp
        nStopThenTp := nStopThenTp + 1
        watching := false

if (buySignal or sellSignal) and canTake
    pending := true
    pIsBuy := buySignal
    pSl := buySignal ? buySl : sellSl
    pTp := buySignal ? buyTp : sellTp

var table stt = na
if showStats and barstate.islast
    table.delete(stt)
    stt := table.new(f_tablePos(), 2, 10, border_width=1, frame_width=1, frame_color=color.new(color.gray, 60))
    // A trade still running has no result yet, so it must not dilute the win
    // rate. nTrades counts it; nWins + nLosses does not.
    nClosed = nWins + nLosses
    wr = nClosed > 0 ? nWins / nClosed * 100 : 0.0
    ex = nClosed > 0 ? sumR / nClosed : 0.0
    table.cell(stt, 0, 0, "RESULTS", text_color=color.gray, bgcolor=color.new(color.black, 70), text_size=size.small)
    table.cell(stt, 1, 0, "", bgcolor=color.new(color.black, 70))
    table.cell(stt, 0, 1, "Trades", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 1, 1, str.tostring(nClosed) + (inTrade ? " (+1 open)" : ""), text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 0, 2, "Win rate", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 1, 2, str.tostring(wr, "#.0") + "%", text_color=wr >= 50 ? color.teal : color.orange, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 0, 3, "W / L", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 1, 3, str.tostring(nWins) + " / " + str.tostring(nLosses), text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 0, 4, "Net R / avg", text_color=color.white, bgcolor=color.new(color.black, 70), text_size=size.small)
    table.cell(stt, 1, 4, str.tostring(sumR, "#.1") + "R / " + str.tostring(ex, "#.2") + "R", text_color=sumR > 0 ? color.teal : color.red, bgcolor=color.new(color.black, 70), text_size=size.small)
    table.cell(stt, 0, 5, "of which spread", text_color=color.gray, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 1, 5, spreadPx <= 0 ? "not charged" : "-" + str.tostring(sumCostR, "#.1") + "R  (" + str.tostring(nClosed > 0 ? sumCostR / nClosed : 0, "#.2") + "R/trade)", text_color=spreadPx <= 0 ? color.orange : color.gray, bgcolor=color.new(color.black, 75), text_size=size.tiny)

    // Live read on the session, and why setups were passed over
    stretchTxt = na(dayStretch) ? "n/a" : str.tostring(dayStretch, "#.00") + "x"
    stretchCol = na(dayStretch) ? color.gray : dayStretch >= 1.3 ? color.red : dayStretch >= 1.0 ? color.orange : color.teal
    table.cell(stt, 0, 6, "24h vs normal", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 1, 6, stretchTxt, text_color=stretchCol, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 0, 7, "Passed over", text_color=color.gray, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 1, 7, str.tostring(nNoRoom) + " room · " + str.tostring(nAdrBlocked) + " day · " + str.tostring(nGapped) + " gap", text_color=color.gray, bgcolor=color.new(color.black, 75), text_size=size.tiny)
    // Stops that were hit while the read was actually right
    stpPct = nLosses > 0 ? nStopThenTp / nLosses * 100 : 0.0
    stpCol = stpPct >= 40 ? color.red : stpPct >= 25 ? color.orange : color.teal
    table.cell(stt, 0, 8, "Stopped, then TP", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 1, 8, str.tostring(nStopThenTp) + " of " + str.tostring(nLosses) + "  (" + str.tostring(stpPct, "#.0") + "%)", text_color=stpCol, bgcolor=color.new(color.black, 75), text_size=size.tiny)
    table.cell(stt, 0, 9, autoTf ? "Auto " + tfName + " · " + strictness : "Manual", text_color=color.white, bgcolor=color.new(color.black, 70), text_size=size.small)
    table.cell(stt, 1, 9, "piv " + str.tostring(pivotLenX) + " / run " + str.tostring(minRunLenX) + " / " + str.tostring(minRRX, "#.0") + "-" + str.tostring(maxStructRRX, "#.0") + "R / stop x" + str.tostring(stopRoom, "#.#"), text_color=color.gray, bgcolor=color.new(color.black, 70), text_size=size.tiny)

alertcondition(buySignal, "BUY", "BUY — sweep + CISD on {{ticker}} @ {{close}}")
alertcondition(sellSignal, "SELL", "SELL — sweep + CISD on {{ticker}} @ {{close}}")
alertcondition(buySignal or sellSignal, "Any signal", "Signal on {{ticker}} ({{interval}}) @ {{close}}")
