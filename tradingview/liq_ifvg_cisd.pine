//@version=5
// Liquidity Sweep + IFVG + CISD
//
//   1. LIQUIDITY SWEEP — price runs beyond a prior swing and closes back
//      inside. Each pool is swept ONCE, then consumed.
//   2. CISD — a close back through the open of the first candle of the last
//      opposing run means delivery has flipped.
//   3. IFVG — a 3-bar gap that later gets closed through flips polarity and
//      acts as support/resistance from the other side.
//
// A sweep arms the setup; a CISD within the arm window fires the entry.
//
// Drawing is deliberately sparse. Only two liquidity levels are ever on the
// chart — the live ones — and they are removed once taken. Fresh gaps are
// hidden by default because they are not actionable; only INVERTED gaps
// (IFVGs) are drawn, since those are the zones you would trade from.
//
// Signals evaluate on CLOSED bars — set alerts to "Once Per Bar Close".

indicator("Liquidity Sweep + IFVG + CISD", shorttitle="Liq+IFVG+CISD", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ── Liquidity ─────────────────────────────────────────────────────────────────
pivotLen = input.int(8, "Swing lookback for liquidity", minval=2, group="Liquidity")
maxPools = input.int(6, "Liquidity pools tracked per side", minval=1, maxval=20, group="Liquidity")
requireCloseBack = input.bool(false, "Sweep candle must also close back inside", group="Liquidity", tooltip="Off by default. CISD is already the reversal confirmation, so demanding rejection on the sweep candle too means almost nothing fires in a trend.")
armBars = input.int(12, "Setup stays armed for (bars)", minval=1, group="Liquidity")
tradeReversal = input.bool(true, "Trade REVERSALS (sweep high -> short)", group="Liquidity")
tradeCont = input.bool(true, "Trade CONTINUATIONS (sweep high, hold above -> long)", group="Liquidity")

// ── CISD ──────────────────────────────────────────────────────────────────────
minRunLen = input.int(2, "Min candles in the opposing run", minval=1, group="CISD")

// ── IFVG ──────────────────────────────────────────────────────────────────────
useIfvg = input.bool(false, "Require price inside an IFVG to enter", group="IFVG")
maxFvg = input.int(10, "Track this many recent gaps", minval=1, maxval=30, group="IFVG")
minFvgAtr = input.float(0.20, "Ignore gaps smaller than (x ATR)", minval=0.0, step=0.05, group="IFVG")
fvgExtend = input.int(50, "Stop extending a zone after (bars)", minval=5, group="IFVG")

// ── Risk ──────────────────────────────────────────────────────────────────────
slBufAtr = input.float(0.25, "Stop beyond sweep extreme (x ATR)", minval=0.0, step=0.05, group="Risk")
maxRiskAtr = input.float(1.5, "Cap risk at (x ATR from entry)", minval=0.3, step=0.1, group="Risk")
rrMult = input.float(2.0, "Target = risk x", minval=0.5, step=0.5, group="Risk")
cooldownBars = input.int(5, "Min bars between signals", minval=0, group="Risk")
confirmedOnly = input.bool(true, "Only signal on closed candles", group="Risk", tooltip="On: a signal appears only once the candle closes, so it can never appear then vanish. Off: signals show live on the forming candle and may disappear if price pulls back before the close.")

// ── What to draw — everything noisy is off by default ────────────────────────
showLiq = input.bool(true, "Live liquidity levels (max 2 on screen)", group="Chart")
showSweepMark = input.bool(true, "Mark the sweep", group="Chart")
showIfvg = input.bool(true, "IFVG zones (inverted gaps only)", group="Chart")
showFreshFvg = input.bool(false, "Also show fresh gaps — noisy", group="Chart")
showPending = input.bool(true, "Live CISD level while a setup is armed", group="Chart")
showCisdOnSignal = input.bool(true, "CISD level on the signal itself", group="Chart")
showPosBox = input.bool(true, "Shade the position (profit / risk)", group="Chart")
tradeBars = input.int(30, "Entry / TP / SL line length (bars)", minval=5, group="Chart")
showStats = input.bool(true, "Results table", group="Chart")

atrV = ta.atr(14)

// ── Liquidity pools — several tracked per side, each usable once ─────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var array<float> poolHi = array.new_float()
var array<float> poolLo = array.new_float()
var array<line> poolHiLn = array.new_line()
var array<line> poolLoLn = array.new_line()

// A pivot confirms pivotLen bars late; if price already traded through the
// level in that window the pool is gone before we could ever use it.
if not na(ph) and ta.highest(high, pivotLen) <= ph
    array.push(poolHi, ph)
    array.push(poolHiLn, showLiq ? line.new(bar_index - pivotLen, ph, bar_index, ph, color=color.new(color.red, 55), style=line.style_dashed, width=1) : na)
    while array.size(poolHi) > maxPools
        dl = array.shift(poolHiLn)
        if not na(dl)
            line.delete(dl)
        array.shift(poolHi)

if not na(pl) and ta.lowest(low, pivotLen) >= pl
    array.push(poolLo, pl)
    array.push(poolLoLn, showLiq ? line.new(bar_index - pivotLen, pl, bar_index, pl, color=color.new(color.teal, 55), style=line.style_dashed, width=1) : na)
    while array.size(poolLo) > maxPools
        dl2 = array.shift(poolLoLn)
        if not na(dl2)
            line.delete(dl2)
        array.shift(poolLo)

// Any untouched pool can be swept, not just the newest one
sweptHigh = false
sweptLow = false
var float sweepHighPx = na
var float sweepLowPx = na
var float sweptHiLvl = na
var float sweptLoLvl = na
var int armedBearBar = -9999
var int armedBullBar = -9999

if array.size(poolHi) > 0
    for i = array.size(poolHi) - 1 to 0
        if i < array.size(poolHi)
            lvl = array.get(poolHi, i)
            if high > lvl and (not requireCloseBack or close < lvl)
                sweptHigh := true
                sweepHighPx := high
                sweptHiLvl := lvl
                dl3 = array.get(poolHiLn, i)
                if not na(dl3)
                    line.delete(dl3)
                array.remove(poolHi, i)
                array.remove(poolHiLn, i)
            else if not na(array.get(poolHiLn, i))
                line.set_x2(array.get(poolHiLn, i), bar_index)

if array.size(poolLo) > 0
    for j = array.size(poolLo) - 1 to 0
        if j < array.size(poolLo)
            lvl2 = array.get(poolLo, j)
            if low < lvl2 and (not requireCloseBack or close > lvl2)
                sweptLow := true
                sweepLowPx := low
                sweptLoLvl := lvl2
                dl4 = array.get(poolLoLn, j)
                if not na(dl4)
                    line.delete(dl4)
                array.remove(poolLo, j)
                array.remove(poolLoLn, j)
            else if not na(array.get(poolLoLn, j))
                line.set_x2(array.get(poolLoLn, j), bar_index)

if sweptHigh
    armedBearBar := bar_index
    if showSweepMark
        label.new(bar_index, high, "SWEEP", style=label.style_label_down, color=color.new(color.red, 25), textcolor=color.white, size=size.tiny)
if sweptLow
    armedBullBar := bar_index
    if showSweepMark
        label.new(bar_index, low, "SWEEP", style=label.style_label_up, color=color.new(color.teal, 25), textcolor=color.white, size=size.tiny)

bullArmed = bar_index - armedBullBar <= armBars
bearArmed = bar_index - armedBearBar <= armBars

// ── CISD ──────────────────────────────────────────────────────────────────────
isDn = close < open
isUp = close > open

var float curDnOpen = na
var int curDnLen = 0
var float curUpOpen = na
var int curUpLen = 0
var float cisdBullLevel = na
var float cisdBearLevel = na

if isDn
    if not isDn[1]
        curDnOpen := open
        curDnLen := 1
    else
        curDnLen := curDnLen + 1
if isUp
    if not isUp[1]
        curUpOpen := open
        curUpLen := 1
    else
        curUpLen := curUpLen + 1

if isUp and isDn[1] and curDnLen >= minRunLen and not na(curDnOpen)
    cisdBullLevel := curDnOpen
if isDn and isUp[1] and curUpLen >= minRunLen and not na(curUpOpen)
    cisdBearLevel := curUpOpen

cisdBull = not na(cisdBullLevel) and close > cisdBullLevel and close[1] <= cisdBullLevel
cisdBear = not na(cisdBearLevel) and close < cisdBearLevel and close[1] >= cisdBearLevel

// While a setup is armed, show the level price has to reclaim for the entry to
// trigger. This is the part worth watching in advance; drawing CISD only after
// the fact told you nothing you could act on.
var line lnPend = na
var label lbPend = na
pendIsBull = bullArmed and not na(cisdBullLevel)
pendIsBear = bearArmed and not na(cisdBearLevel)
pendLvl = pendIsBull ? cisdBullLevel : pendIsBear ? cisdBearLevel : na

if showPending
    line.delete(lnPend)
    label.delete(lbPend)
    if not na(pendLvl)
        pcol = pendIsBull ? color.teal : color.red
        pFrom = pendIsBull ? armedBullBar : armedBearBar
        lnPend := line.new(pFrom, pendLvl, bar_index + 4, pendLvl, color=color.new(pcol, 25), style=line.style_dotted, width=2)
        lbPend := label.new(bar_index + 4, pendLvl, "CISD " + str.tostring(pendLvl, format.mintick), style=label.style_label_left, color=color.new(pcol, 55), textcolor=color.white, size=size.tiny)

// ── Gaps: tracked always, drawn only once they invert into IFVGs ─────────────
var array<float> fTop = array.new_float()
var array<float> fBot = array.new_float()
var array<int> fDir = array.new_int()
var array<bool> fInv = array.new_bool()
var array<int> fBar = array.new_int()
var array<box> fBox = array.new_box()

bullGap = low > high[2] and (low - high[2]) >= atrV * minFvgAtr
bearGap = high < low[2] and (low[2] - high) >= atrV * minFvgAtr

if bullGap
    array.push(fTop, low)
    array.push(fBot, high[2])
    array.push(fDir, 1)
    array.push(fInv, false)
    array.push(fBar, bar_index)
    array.push(fBox, showFreshFvg ? box.new(bar_index - 2, low, bar_index, high[2], border_color=color.new(color.gray, 80), bgcolor=color.new(color.teal, 94)) : na)
if bearGap
    array.push(fTop, low[2])
    array.push(fBot, high)
    array.push(fDir, -1)
    array.push(fInv, false)
    array.push(fBar, bar_index)
    array.push(fBox, showFreshFvg ? box.new(bar_index - 2, low[2], bar_index, high, border_color=color.new(color.gray, 80), bgcolor=color.new(color.red, 94)) : na)

while array.size(fTop) > maxFvg
    ob = array.shift(fBox)
    if not na(ob)
        box.delete(ob)
    array.shift(fTop)
    array.shift(fBot)
    array.shift(fDir)
    array.shift(fInv)
    array.shift(fBar)

inBullIfvg = false
inBearIfvg = false
if array.size(fTop) > 0
    for i = 0 to array.size(fTop) - 1
        ft = array.get(fTop, i)
        fb = array.get(fBot, i)
        fd = array.get(fDir, i)
        fi = array.get(fInv, i)
        fx = array.get(fBox, i)
        st = array.get(fBar, i)
        if not fi
            violated = fd == 1 ? close < fb : close > ft
            if violated
                array.set(fInv, i, true)
                // The zone only becomes worth drawing at the moment it inverts
                if showIfvg
                    bull = fd == -1
                    col = bull ? color.teal : color.orange
                    if na(fx)
                        fx := box.new(bar_index, ft, bar_index + 1, fb, border_color=color.new(col, 30), bgcolor=color.new(col, 85), border_width=1)
                        array.set(fBox, i, fx)
                    else
                        box.set_bgcolor(fx, color.new(col, 85))
                        box.set_border_color(fx, color.new(col, 30))
                        box.set_border_width(fx, 1)
                    label.new(bar_index, bull ? fb : ft, "IFVG", style=bull ? label.style_label_up : label.style_label_down, color=color.new(col, 30), textcolor=color.white, size=size.tiny)
        else
            if fd == -1 and low <= ft and high >= fb
                inBullIfvg := true
            if fd == 1 and high >= ft and low <= fb
                inBearIfvg := true
        if not na(fx) and bar_index - st <= fvgExtend
            box.set_right(fx, bar_index + 1)

// ── Entry ─────────────────────────────────────────────────────────────────────
var int lastSigBar = -9999
cooled = bar_index - lastSigBar >= cooldownBars

ifvgBuyOk = not useIfvg or inBullIfvg
ifvgSellOk = not useIfvg or inBearIfvg

// REVERSAL: liquidity taken, then price turns back. Wrong if it runs on.
revBuy = tradeReversal and bullArmed and cisdBull and not na(sweepLowPx)
revSell = tradeReversal and bearArmed and cisdBear and not na(sweepHighPx)

// CONTINUATION: liquidity taken and price HOLDS beyond it. Wrong if it
// falls back inside the level it just cleared.
contBuy = tradeCont and bearArmed and cisdBull and not na(sweptHiLvl) and close > sweptHiLvl
contSell = tradeCont and bullArmed and cisdBear and not na(sweptLoLvl) and close < sweptLoLvl

rawBuy = (revBuy or contBuy) and cooled and ifvgBuyOk
rawSell = (revSell or contSell) and cooled and ifvgSellOk

// Stop sits at whatever invalidates that particular premise
buyAnchor = revBuy ? sweepLowPx : sweptHiLvl
sellAnchor = revSell ? sweepHighPx : sweptLoLvl
buySl = math.max(buyAnchor - atrV * slBufAtr, close - atrV * maxRiskAtr)
sellSl = math.min(sellAnchor + atrV * slBufAtr, close + atrV * maxRiskAtr)
buyRisk = close - buySl
sellRisk = sellSl - close
buyTp = close + buyRisk * rrMult
sellTp = close - sellRisk * rrMult

// On the forming bar `close` is just the current price, so a live signal can
// appear and then vanish if price pulls back before the candle closes.
barOk = not confirmedOnly or barstate.isconfirmed
buyOk = rawBuy and buyRisk > 0 and barOk
sellOk = rawSell and sellRisk > 0 and barOk
buySignal = buyOk and not sellOk
sellSignal = sellOk and not buyOk

// Entry / TP / SL as three clean lines rather than filled blocks
f_draw(isBuy, entry, tp, sl, cisdLvl, kind) =>
    col = isBuy ? color.teal : color.red
    x1 = bar_index
    x2 = bar_index + tradeBars
    line.new(x1, entry, x2, entry, color=color.new(col, 0), width=2)
    line.new(x1, tp, x2, tp, color=color.new(color.teal, 20), style=line.style_dashed, width=1)
    line.new(x1, sl, x2, sl, color=color.new(color.red, 20), style=line.style_dashed, width=1)
    label.new(x2, entry, (isBuy ? "▲ BUY " : "▼ SELL ") + kind + " " + str.tostring(entry, format.mintick), style=label.style_label_left, color=color.new(col, 15), textcolor=color.white, size=size.small)
    label.new(x2, tp, "TP " + str.tostring(tp, format.mintick), style=label.style_label_left, color=color.new(color.teal, 40), textcolor=color.white, size=size.tiny)
    label.new(x2, sl, "SL " + str.tostring(sl, format.mintick), style=label.style_label_left, color=color.new(color.red, 40), textcolor=color.white, size=size.tiny)
    if showPosBox
        box.new(x1, math.max(tp, entry), x2, math.min(tp, entry), border_color=color.new(color.teal, 80), bgcolor=color.new(color.teal, 90))
        box.new(x1, math.max(entry, sl), x2, math.min(entry, sl), border_color=color.new(color.red, 80), bgcolor=color.new(color.red, 90))
    if showCisdOnSignal and not na(cisdLvl)
        line.new(x1 - 10, cisdLvl, x1 + 2, cisdLvl, color=color.new(col, 0), style=line.style_dotted, width=2)
        label.new(x1 - 10, cisdLvl, "CISD ✓ " + str.tostring(cisdLvl, format.mintick), style=label.style_label_right, color=color.new(col, 25), textcolor=color.white, size=size.tiny)

if buySignal
    f_draw(true, close, buyTp, buySl, cisdBullLevel, revBuy ? "rev" : "cont")
    lastSigBar := bar_index
if sellSignal
    f_draw(false, close, sellTp, sellSl, cisdBearLevel, revSell ? "rev" : "cont")
    lastSigBar := bar_index

// ── Outcome tracking ──────────────────────────────────────────────────────────
var bool inTrade = false
var bool tIsBuy = false
var float tSl = na
var float tTp = na
var float tRisk = na
var int tBar = na
var int nTrades = 0
var int nWins = 0
var int nLosses = 0
var float sumR = 0.0

if (buySignal or sellSignal) and not inTrade
    inTrade := true
    tIsBuy := buySignal
    tSl := buySignal ? buySl : sellSl
    tTp := buySignal ? buyTp : sellTp
    tRisk := math.abs(close - tSl)
    tBar := bar_index
    nTrades := nTrades + 1

if inTrade and bar_index > tBar
    hitSl = tIsBuy ? low <= tSl : high >= tSl
    hitTp = tIsBuy ? high >= tTp : low <= tTp
    if hitSl
        sumR := sumR - 1.0
        nLosses := nLosses + 1
        inTrade := false
    else if hitTp
        sumR := sumR + rrMult
        nWins := nWins + 1
        inTrade := false

var table stt = na
if showStats and barstate.islast
    table.delete(stt)
    stt := table.new(position.top_right, 2, 5, border_width=1, frame_width=1, frame_color=color.new(color.gray, 60))
    wr = nTrades > 0 ? nWins / nTrades * 100 : 0.0
    ex = nTrades > 0 ? sumR / nTrades : 0.0
    table.cell(stt, 0, 0, "RESULTS", text_color=color.gray, bgcolor=color.new(color.black, 70), text_size=size.small)
    table.cell(stt, 1, 0, "", bgcolor=color.new(color.black, 70))
    table.cell(stt, 0, 1, "Trades", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 1, 1, str.tostring(nTrades), text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 0, 2, "Win rate", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 1, 2, str.tostring(wr, "#.0") + "%", text_color=wr >= 50 ? color.teal : color.orange, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 0, 3, "W / L", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 1, 3, str.tostring(nWins) + " / " + str.tostring(nLosses), text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(stt, 0, 4, "Net R / avg", text_color=color.white, bgcolor=color.new(color.black, 70), text_size=size.small)
    table.cell(stt, 1, 4, str.tostring(sumR, "#.1") + "R / " + str.tostring(ex, "#.2") + "R", text_color=sumR > 0 ? color.teal : color.red, bgcolor=color.new(color.black, 70), text_size=size.small)

alertcondition(buySignal, "BUY sweep+CISD", "BUY — liquidity swept low, CISD confirmed on {{ticker}} @ {{close}}")
alertcondition(sellSignal, "SELL sweep+CISD", "SELL — liquidity swept high, CISD confirmed on {{ticker}} @ {{close}}")
alertcondition(buySignal or sellSignal, "Any signal", "Sweep + CISD signal on {{ticker}} ({{interval}}) @ {{close}}")
