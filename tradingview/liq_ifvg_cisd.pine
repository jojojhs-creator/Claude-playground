//@version=5
// Liquidity Sweep + IFVG + CISD
//
//   1. LIQUIDITY SWEEP — price runs beyond a prior swing and closes back
//      inside. Each pool can only be swept ONCE; after that it is consumed.
//   2. CISD — the open of the first candle of the last opposing run is
//      stored. A close back through it means delivery has flipped.
//   3. IFVG — a 3-bar gap that later gets closed through flips polarity and
//      acts as support/resistance from the other side.
//
// A sweep arms the setup; a CISD within the arm window fires the entry.
//
// Order geometry is bounded, not open-ended: risk is capped at maxRisk ATR
// from entry, and the target is a multiple of that risk. Anchoring the stop
// to a sweep several bars back while targeting a distant swing produced
// enormous, untradeable boxes.
//
// Signals evaluate on CLOSED bars — set alerts to "Once Per Bar Close".

indicator("Liquidity Sweep + IFVG + CISD", shorttitle="Liq+IFVG+CISD", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ── Liquidity ─────────────────────────────────────────────────────────────────
pivotLen = input.int(10, "Swing lookback for liquidity", minval=2, group="Liquidity")
armBars = input.int(6, "Setup stays armed for (bars)", minval=1, group="Liquidity")
showLiqLines = input.bool(true, "Draw liquidity levels", group="Liquidity")

// ── CISD ──────────────────────────────────────────────────────────────────────
minRunLen = input.int(2, "Min candles in the opposing run", minval=1, group="CISD")
showCisd = input.bool(true, "Draw CISD levels", group="CISD")

// ── IFVG ──────────────────────────────────────────────────────────────────────
useIfvg = input.bool(false, "Require price inside an IFVG to enter", group="IFVG")
maxFvg = input.int(10, "Track this many recent gaps", minval=1, maxval=30, group="IFVG")
minFvgAtr = input.float(0.20, "Ignore gaps smaller than (x ATR)", minval=0.0, step=0.05, group="IFVG")
fvgExtend = input.int(60, "Stop extending a gap after (bars)", minval=5, group="IFVG")
showFvg = input.bool(true, "Draw gaps", group="IFVG")

// ── Risk — these keep the position boxes sane ────────────────────────────────
slBufAtr = input.float(0.25, "Stop beyond sweep extreme (x ATR)", minval=0.0, step=0.05, group="Risk")
maxRiskAtr = input.float(1.5, "Cap risk at (x ATR from entry)", minval=0.3, step=0.1, group="Risk")
rrMult = input.float(2.0, "Target = risk x", minval=0.5, step=0.5, group="Risk")
useLiqTarget = input.bool(false, "Target opposing liquidity instead (if reachable)", group="Risk")
maxTpR = input.float(4.0, "…but never further than this many R", minval=1.0, step=0.5, group="Risk")
cooldownBars = input.int(5, "Min bars between signals", minval=0, group="Risk")

// ── Display ───────────────────────────────────────────────────────────────────
showPos = input.bool(true, "Draw position box", group="Display")
posBars = input.int(30, "Position box length (bars)", minval=5, group="Display")
showSweeps = input.bool(true, "Mark sweeps", group="Display")
showStats = input.bool(true, "Show results table", group="Display")

atrV = ta.atr(14)

// ── Liquidity pools, each usable once ────────────────────────────────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float liqHigh = na
var float liqLow = na
var bool liqHighUsed = true
var bool liqLowUsed = true

if not na(ph)
    liqHigh := ph
    // A pivot is confirmed pivotLen bars late. If price already traded through
    // it during that lag, the pool is gone — do not report it as a fresh sweep.
    liqHighUsed := ta.highest(high, pivotLen) > ph
    if showLiqLines and not liqHighUsed
        line.new(bar_index - pivotLen, ph, bar_index, ph, color=color.new(color.red, 60), style=line.style_dotted, extend=extend.right)

if not na(pl)
    liqLow := pl
    liqLowUsed := ta.lowest(low, pivotLen) < pl
    if showLiqLines and not liqLowUsed
        line.new(bar_index - pivotLen, pl, bar_index, pl, color=color.new(color.teal, 60), style=line.style_dotted, extend=extend.right)

// Fire once, then consume the pool
sweptLow = not na(liqLow) and not liqLowUsed and low < liqLow and close > liqLow
sweptHigh = not na(liqHigh) and not liqHighUsed and high > liqHigh and close < liqHigh

var int armedBullBar = -9999
var float sweepLowPx = na
var int armedBearBar = -9999
var float sweepHighPx = na

if sweptLow
    liqLowUsed := true
    armedBullBar := bar_index
    sweepLowPx := low
if sweptHigh
    liqHighUsed := true
    armedBearBar := bar_index
    sweepHighPx := high

bullArmed = bar_index - armedBullBar <= armBars
bearArmed = bar_index - armedBearBar <= armBars

// ── CISD ──────────────────────────────────────────────────────────────────────
isDn = close < open
isUp = close > open

var float curDnOpen = na
var int curDnLen = 0
var float curUpOpen = na
var int curUpLen = 0
var float cisdBullLevel = na
var float cisdBearLevel = na

if isDn
    if not isDn[1]
        curDnOpen := open
        curDnLen := 1
    else
        curDnLen := curDnLen + 1
if isUp
    if not isUp[1]
        curUpOpen := open
        curUpLen := 1
    else
        curUpLen := curUpLen + 1

if isUp and isDn[1] and curDnLen >= minRunLen and not na(curDnOpen)
    cisdBullLevel := curDnOpen
if isDn and isUp[1] and curUpLen >= minRunLen and not na(curUpOpen)
    cisdBearLevel := curUpOpen

cisdBull = not na(cisdBullLevel) and close > cisdBullLevel and close[1] <= cisdBullLevel
cisdBear = not na(cisdBearLevel) and close < cisdBearLevel and close[1] >= cisdBearLevel

if showCisd and cisdBull
    line.new(bar_index - 3, cisdBullLevel, bar_index, cisdBullLevel, color=color.new(color.teal, 20), width=1)
if showCisd and cisdBear
    line.new(bar_index - 3, cisdBearLevel, bar_index, cisdBearLevel, color=color.new(color.red, 20), width=1)

// ── Fair value gaps and their inversion ──────────────────────────────────────
var array<float> fTop = array.new_float()
var array<float> fBot = array.new_float()
var array<int> fDir = array.new_int()
var array<bool> fInv = array.new_bool()
var array<int> fBar = array.new_int()
var array<box> fBox = array.new_box()

bullGap = low > high[2] and (low - high[2]) >= atrV * minFvgAtr
bearGap = high < low[2] and (low[2] - high) >= atrV * minFvgAtr

if bullGap
    array.push(fTop, low)
    array.push(fBot, high[2])
    array.push(fDir, 1)
    array.push(fInv, false)
    array.push(fBar, bar_index)
    array.push(fBox, showFvg ? box.new(bar_index - 2, low, bar_index, high[2], border_color=color.new(color.teal, 80), bgcolor=color.new(color.teal, 92)) : na)
if bearGap
    array.push(fTop, low[2])
    array.push(fBot, high)
    array.push(fDir, -1)
    array.push(fInv, false)
    array.push(fBar, bar_index)
    array.push(fBox, showFvg ? box.new(bar_index - 2, low[2], bar_index, high, border_color=color.new(color.red, 80), bgcolor=color.new(color.red, 92)) : na)

while array.size(fTop) > maxFvg
    ob = array.shift(fBox)
    if not na(ob)
        box.delete(ob)
    array.shift(fTop)
    array.shift(fBot)
    array.shift(fDir)
    array.shift(fInv)
    array.shift(fBar)

inBullIfvg = false
inBearIfvg = false
if array.size(fTop) > 0
    for i = 0 to array.size(fTop) - 1
        ft = array.get(fTop, i)
        fb = array.get(fBot, i)
        fd = array.get(fDir, i)
        fi = array.get(fInv, i)
        fx = array.get(fBox, i)
        if not fi
            if fd == 1 and close < fb
                array.set(fInv, i, true)
                if not na(fx)
                    box.set_bgcolor(fx, color.new(color.orange, 88))
                    box.set_border_color(fx, color.new(color.orange, 60))
            if fd == -1 and close > ft
                array.set(fInv, i, true)
                if not na(fx)
                    box.set_bgcolor(fx, color.new(color.blue, 88))
                    box.set_border_color(fx, color.new(color.blue, 60))
        else
            if fd == -1 and low <= ft and high >= fb
                inBullIfvg := true
            if fd == 1 and high >= ft and low <= fb
                inBearIfvg := true
        // Stop extending eventually, otherwise the chart fills with boxes
        if not na(fx) and bar_index - array.get(fBar, i) <= fvgExtend
            box.set_right(fx, bar_index + 1)

// ── Entry ─────────────────────────────────────────────────────────────────────
var int lastSigBar = -9999
cooled = bar_index - lastSigBar >= cooldownBars

ifvgBuyOk = not useIfvg or inBullIfvg
ifvgSellOk = not useIfvg or inBearIfvg

rawBuy = bullArmed and cisdBull and cooled and ifvgBuyOk and not na(sweepLowPx)
rawSell = bearArmed and cisdBear and cooled and ifvgSellOk and not na(sweepHighPx)

// Stop beyond the sweep, but never more than maxRisk ATR from entry
buySl = math.max(sweepLowPx - atrV * slBufAtr, close - atrV * maxRiskAtr)
sellSl = math.min(sweepHighPx + atrV * slBufAtr, close + atrV * maxRiskAtr)

buyRisk = close - buySl
sellRisk = sellSl - close

// Target is a multiple of the actual risk, so the boxes stay proportional
buyTpR = close + buyRisk * rrMult
sellTpR = close - sellRisk * rrMult
buyTpLiq = not na(liqHigh) and liqHigh > close ? math.min(liqHigh, close + buyRisk * maxTpR) : buyTpR
sellTpLiq = not na(liqLow) and liqLow < close ? math.max(liqLow, close - sellRisk * maxTpR) : sellTpR
buyTp = useLiqTarget ? buyTpLiq : buyTpR
sellTp = useLiqTarget ? sellTpLiq : sellTpR

f_rr(entry, tp, sl) =>
    risk = math.abs(entry - sl)
    risk > 0 ? math.abs(tp - entry) / risk : 0.0

buyOk = rawBuy and buyRisk > 0 and buyTp > close and f_rr(close, buyTp, buySl) >= 1.0
sellOk = rawSell and sellRisk > 0 and sellTp < close and f_rr(close, sellTp, sellSl) >= 1.0

buySignal = buyOk and not sellOk
sellSignal = sellOk and not buyOk

f_draw(isBuy, entry, tp, sl) =>
    col = isBuy ? color.teal : color.red
    rr = f_rr(entry, tp, sl)
    txt = (isBuy ? "▲ BUY" : "▼ SELL") + "\nsweep + CISD" + (useIfvg ? " + IFVG" : "") + "\nTP " + str.tostring(tp, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "\nR:R " + str.tostring(rr, "#.1")
    yP = isBuy ? low - atrV * 0.6 : high + atrV * 0.6
    label.new(bar_index, yP, txt, style=isBuy ? label.style_label_up : label.style_label_down, color=color.new(col, 10), textcolor=color.white, size=size.small)
    if showPos
        x1 = bar_index
        x2 = bar_index + posBars
        box.new(x1, math.max(tp, entry), x2, math.min(tp, entry), border_color=color.new(color.teal, 70), bgcolor=color.new(color.teal, 88))
        box.new(x1, math.max(entry, sl), x2, math.min(entry, sl), border_color=color.new(color.red, 70), bgcolor=color.new(color.red, 88))
        line.new(x1, entry, x2, entry, color=color.new(col, 0), width=1)

if buySignal
    f_draw(true, close, buyTp, buySl)
    lastSigBar := bar_index
if sellSignal
    f_draw(false, close, sellTp, sellSl)
    lastSigBar := bar_index

// ── Outcome tracking ──────────────────────────────────────────────────────────
var bool inTrade = false
var bool tIsBuy = false
var float tEntry = na
var float tSl = na
var float tTp = na
var float tRisk = na
var int tBar = na
var int nTrades = 0
var int nWins = 0
var int nLosses = 0
var float sumR = 0.0

if (buySignal or sellSignal) and not inTrade
    inTrade := true
    tIsBuy := buySignal
    tEntry := close
    tSl := buySignal ? buySl : sellSl
    tTp := buySignal ? buyTp : sellTp
    tRisk := math.abs(tEntry - tSl)
    tBar := bar_index
    nTrades := nTrades + 1

if inTrade and bar_index > tBar
    fullR = tRisk > 0 ? math.abs(tTp - tEntry) / tRisk : 0.0
    hitSl = tIsBuy ? low <= tSl : high >= tSl
    hitTp = tIsBuy ? high >= tTp : low <= tTp
    if hitSl
        sumR := sumR - 1.0
        nLosses := nLosses + 1
        inTrade := false
    else if hitTp
        sumR := sumR + fullR
        nWins := nWins + 1
        inTrade := false

var table st = na
if showStats and barstate.islast
    table.delete(st)
    st := table.new(position.top_right, 2, 5, border_width=1, frame_width=1, frame_color=color.new(color.gray, 60))
    wr = nTrades > 0 ? nWins / nTrades * 100 : 0.0
    ex = nTrades > 0 ? sumR / nTrades : 0.0
    table.cell(st, 0, 0, "RESULTS", text_color=color.gray, bgcolor=color.new(color.black, 70), text_size=size.small)
    table.cell(st, 1, 0, "", bgcolor=color.new(color.black, 70))
    table.cell(st, 0, 1, "Trades", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(st, 1, 1, str.tostring(nTrades), text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(st, 0, 2, "Win rate", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(st, 1, 2, str.tostring(wr, "#.0") + "%", text_color=wr >= 50 ? color.teal : color.orange, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(st, 0, 3, "W / L", text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(st, 1, 3, str.tostring(nWins) + " / " + str.tostring(nLosses), text_color=color.white, bgcolor=color.new(color.black, 75), text_size=size.small)
    table.cell(st, 0, 4, "Net R / avg", text_color=color.white, bgcolor=color.new(color.black, 70), text_size=size.small)
    table.cell(st, 1, 4, str.tostring(sumR, "#.1") + "R / " + str.tostring(ex, "#.2") + "R", text_color=sumR > 0 ? color.teal : color.red, bgcolor=color.new(color.black, 70), text_size=size.small)

plotshape(showSweeps and sweptLow, "Sweep low", style=shape.xcross, location=location.belowbar, color=color.new(color.teal, 30), size=size.tiny)
plotshape(showSweeps and sweptHigh, "Sweep high", style=shape.xcross, location=location.abovebar, color=color.new(color.red, 30), size=size.tiny)

alertcondition(buySignal, "BUY sweep+CISD", "BUY — liquidity swept low, CISD confirmed on {{ticker}} @ {{close}}")
alertcondition(sellSignal, "SELL sweep+CISD", "SELL — liquidity swept high, CISD confirmed on {{ticker}} @ {{close}}")
alertcondition(buySignal or sellSignal, "Any signal", "Sweep + CISD signal on {{ticker}} ({{interval}}) @ {{close}}")
