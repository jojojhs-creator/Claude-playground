# ─── MT5 Terminal ─────────────────────────────────────────────────────────────
MT5_LOGIN=123456
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo
MT5_PATH=                              # Leave blank for auto-detect

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_ALLOWED_CHAT_IDS=111111111,222222222   # comma-separated chat IDs

# ─── Trading ──────────────────────────────────────────────────────────────────
SYMBOLS=XAUUSD,BTCUSD
TIMEZONE=UTC
MAX_RISK_PERCENT=2.0                   # % of equity risked per trade (used only if no fixed lot)

# ─── Fixed Lot Sizes (optional — overrides dynamic lot sizing) ─────────────────
# Leave blank to use dynamic risk-based sizing (MAX_RISK_PERCENT above)
XAUUSD_LOT=0.01
BTCUSD_LOT=0.03

# ─── Technical Indicators ─────────────────────────────────────────────────────
EMA_FAST=20
EMA_SLOW=50
EMA_100=100
SMA_200=200
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ATR_PERIOD=14
ADX_PERIOD=14
SR_LOOKBACK=50                         # bars to look back for swing S/R levels

# ─── Trend Strength (ADX thresholds) ──────────────────────────────────────────
TREND_WEAK_THRESHOLD=25.0              # ADX < 25  → weak  (1.5× ATR TP)
TREND_STRONG_THRESHOLD=50.0            # ADX >= 50 → strong (3.5× ATR TP)
                                       # 25 <= ADX < 50 → medium (2.5× ATR TP)

# ─── Take Profit Multipliers (× ATR) ──────────────────────────────────────────
TP_MULTIPLIER_WEAK=1.5
TP_MULTIPLIER_MEDIUM=2.5
TP_MULTIPLIER_STRONG=3.5

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
