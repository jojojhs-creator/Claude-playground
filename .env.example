# ─── MT5 Terminal ─────────────────────────────────────────────────────────────
MT5_LOGIN=123456
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo
MT5_PATH=                              # Leave blank for auto-detect

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_ALLOWED_CHAT_IDS=111111111,222222222   # comma-separated chat IDs

# ─── Trading ──────────────────────────────────────────────────────────────────
SYMBOLS=XAUUSD
WEEKEND_SYMBOLS=BTCUSD                 # traded when the main markets are shut (crypto is 24/7)
SKIP_CLOSED_MARKETS=true               # detect closed markets via stale ticks and skip them
TIMEZONE=UTC

# ─── Trailing Stop (locks profit as the trade moves your way) ──────────────────
TRAIL_ACTIVATE_USD=15                  # start trailing once profit reaches this $ (0 = off)
TRAIL_DISTANCE_USD=8                   # keep the SL this many $ behind the best profit seen
MAX_RISK_PERCENT=2.0                   # % of equity risked per trade (used only if no fixed lot)

# ─── Scalping Parameters ───────────────────────────────────────────────────────
SL_ATR_MULTIPLIER=1.0                  # SL = trigger-timeframe ATR × this value
RR_RATIO=3.0                           # TP = SL distance × this value (3.0 = 1:3 risk-reward)

# ─── Signal Quality ────────────────────────────────────────────────────────────
MIN_ADX=15                             # skip trades when ADX below this (no-trend chop filter; 0 = off)
SIGNAL_THRESHOLD=4                     # conditions (of 7) required to fire — lower = more trades
REQUIRE_MOMENTUM=true                  # MACD must agree with direction (no counter-momentum trades)

# ─── Balanced Scalp Mode (RECOMMENDED — M5 trigger, quick but not noisy) ───────
BALANCED_MODE=true                     # true → H1/M15/M5 timeframes, completed-bar entries
TRADE_START_HOUR=13                    # only open trades from this UTC hour (London–NY overlap)
TRADE_END_HOUR=17                      # ...until this UTC hour (0 & 24 = trade all day)
QUICK_PROFIT_USD=22                    # close a winner at +$22 (a ~$2.2 gold move)
MAX_LOSS_USD=12                        # hard-close a loser at -$12 (~1.8:1 reward:risk)

# ─── Scalp Mode (1-minute quick trades — high spread cost, not recommended) ─────
SCALP_MODE=false                       # true → M15/M5/M1 timeframes, M1 ATR stops
# SCAN_INTERVAL_SECONDS=60             # scan interval (auto: 30 balanced / 60 scalp / 300 swing)
# MAX_POSITIONS_PER_SYMBOL=1           # concurrent trades per symbol (auto by mode)
# MAX_TRADE_AGE_MINUTES=15             # force-close bot trades older than this (0 = off)

# ─── Turbo Mode (seconds-scale — very high spread cost, demo experiments only) ──
TURBO_MODE=false                       # true → live-bar entries, 5s scan, quick $ exits

# ─── Fixed Lot Sizes (optional — overrides dynamic lot sizing) ─────────────────
# Leave blank to use dynamic risk-based sizing (MAX_RISK_PERCENT above)
XAUUSD_LOT=0.01
BTCUSD_LOT=0.03

# ─── Technical Indicators ─────────────────────────────────────────────────────
EMA_FAST=20
EMA_SLOW=50
EMA_100=100
SMA_200=200
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ATR_PERIOD=14
ADX_PERIOD=14
SR_LOOKBACK=50                         # bars to look back for swing S/R levels

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
